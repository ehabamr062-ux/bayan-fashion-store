rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔒 منع الوصول العشوائي لجذر قاعدة البيانات أو أي مسار غير معرّف
    match /{document=**} {
      allow read, write: if false;
    }

    // 🏪 عزل بيانات كل متجر تحت shops/{shopId} (Multi-Tenant)
    match /shops/{shopId} {
      // السماح بقراءة/تحديث وثيقة المتجر الأساسية فقط إذا كان shopId صالحاً
      allow read, write: if shopId.size() >= 3 && shopId.size() <= 64;

      // 📦 المنتجات: القراءة عامة للمتجر، والكتابة تتحقق من سلامة السعر والرصيد
      match /products/{productId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().size() <= 60
          && (!('price' in request.resource.data) || (request.resource.data.price is number && request.resource.data.price >= 0))
          && (!('stock' in request.resource.data) || (request.resource.data.stock is number && request.resource.data.stock >= 0));
        allow delete: if true;
      }

      // 🛒 الطلبات: التحقق من صحة الحقول الأساسية ومنع القيم السالبة عند إنشاء الطلب
      match /orders/{orderId} {
        allow read: if true;
        allow create: if request.resource.data.customerName is string
          && request.resource.data.customerName.size() >= 2
          && request.resource.data.customerName.size() <= 120
          && request.resource.data.phone1 is string
          && request.resource.data.phone1.size() >= 8
          && request.resource.data.grandTotal is number
          && request.resource.data.grandTotal >= 0
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 50;
        allow update, delete: if true;
      }

      // 🎟️ الكوبونات
      match /coupons/{couponId} {
        allow read: if true;
        allow create, update: if (!('value' in request.resource.data) || (request.resource.data.value is number && request.resource.data.value >= 0))
          && (!('maxUses' in request.resource.data) || (request.resource.data.maxUses is number && request.resource.data.maxUses >= 0));
        allow delete: if true;
      }

      // ⚙️ الإعدادات والشحن والعدادات وآراء العملاء
      match /settings/{settingId} {
        allow read, write: if true;
      }

      match /testimonials/{testiId} {
        allow read, write: if true;
      }

      match /meta/{metaId} {
        allow read, write: if true;
      }

      // 🛒 السلات المتروكة (Abandoned Carts)
      match /abandoned_carts/{cartId} {
        allow read, write: if true;
      }
    }
  }
}
